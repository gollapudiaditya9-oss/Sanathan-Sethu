# =============================================================================
# SanatanaSetu — environment variables
# =============================================================================
# Copy this file to .env (or .env.local) and fill in real values.
# DO NOT commit .env or .env.local to git. .gitignore should exclude both.
#
# Conventions:
#   - NUXT_PUBLIC_* variables are exposed to the browser. Use for non-secrets only.
#   - All other NUXT_* variables are server-side only (server/api routes).
#
# Required vs optional:
#   [REQUIRED]  — build/dev fails if missing
#   [OPTIONAL]  — feature degrades gracefully if missing (e.g. logs warning)
#   [BLOCKED]   — value not yet decided; placeholder for now, blocks Phase 6 launch
# =============================================================================


# --- Public site identity ---------------------------------------------------

# [REQUIRED] Canonical site URL. Used for canonical tags, sitemap, OG images.
# Dev:    http://localhost:3000
# Prod:   https://sanatanasetu.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# [REQUIRED] Default support email surfaced in footer + transactional copy.
NUXT_PUBLIC_SUPPORT_EMAIL=hello@sanatanasetu.com


# --- Antyeshti notification routing ----------------------------------------
# When a family submits the Antyeshti form, these endpoints get notified
# IMMEDIATELY. The 4-hour callback SLA depends on these working.

# [REQUIRED] Email address(es) that receive Antyeshti requests.
# Comma-separated for multiple recipients.
# Format: coordinator1@sanatanasetu.com,coordinator2@sanatanasetu.com
NUXT_ANTYESHTI_NOTIFICATION_EMAIL=antyeshti@sanatanasetu.com

# [BLOCKED] SMS/WhatsApp number for instant alert (founder decision pending).
# Format: +91 followed by 10 digits, no spaces or dashes
# Example: +919876543210
NUXT_ANTYESHTI_NOTIFICATION_PHONE=

# [OPTIONAL] Slack webhook for the coordinator team channel.
# If present, posts a structured message on every Antyeshti request.
NUXT_ANTYESHTI_SLACK_WEBHOOK=


# --- Booking notification routing ------------------------------------------

# [REQUIRED] Email address that receives new booking confirmations.
NUXT_BOOKING_NOTIFICATION_EMAIL=bookings@sanatanasetu.com

# [OPTIONAL] Slack webhook for the bookings team channel.
NUXT_BOOKING_SLACK_WEBHOOK=


# --- Transactional email provider ------------------------------------------
# [BLOCKED] Pick one provider before launch. Recommended: Resend (simple,
# affordable, has Vercel-friendly SDK). Postmark is also fine for transactional.

# Provider name: resend | postmark | sendgrid
NUXT_EMAIL_PROVIDER=

# API key for the chosen provider.
NUXT_EMAIL_API_KEY=

# From-address. Must be verified with the email provider.
NUXT_EMAIL_FROM=noreply@sanatanasetu.com


# --- Panchangam data ----------------------------------------------------------
# The /calendar page needs real panchangam data. Options:
#   1. ProKerala API           https://www.prokerala.com/astrology/
#   2. Drik Panchang API       https://www.drikpanchang.com/
#   3. Self-host calculation   (Drik Ganitha library, Python or Node)
#
# [BLOCKED] Decision pending. Until then, /calendar shows placeholder data
# from data/calendar-festivals.json with [verify-with-panchangam-scholar] flags.

NUXT_PANCHANGAM_PROVIDER=
NUXT_PANCHANGAM_API_KEY=

# Default location for panchangam queries (when user hasn't set their own).
# Format: "City, State" — used for Drik Ganitha calculation.
NUXT_PANCHANGAM_DEFAULT_LOCATION=Hyderabad, Telangana


# --- Setu AI (the Library) ---------------------------------------------------
# Powers the chat at /library. Without a key, the page still renders but shows
# a "not connected yet" message instead of an answer — see server/api/setu-ai.

# [OPTIONAL] Only 'anthropic' is wired today. Left here for when a second
# provider is added.
NUXT_AI_PROVIDER=anthropic

# [BLOCKED] Anthropic API key. Get one at https://console.anthropic.com/
NUXT_AI_API_KEY=

# [OPTIONAL] Defaults to claude-sonnet-5 if unset.
NUXT_AI_MODEL=claude-sonnet-5


# --- Database (Phase 6) -------------------------------------------------------
# [BLOCKED] Database choice pending. Options being considered:
#   - Supabase (Postgres + auth + storage + dashboard for non-engineers)
#   - PlanetScale (MySQL, branching workflow)
#   - Neon (Postgres, serverless, generous free tier)
#
# Until Phase 6, all data lives in JSON files in /data/.

NUXT_DATABASE_URL=
NUXT_DATABASE_DIRECT_URL=  # for migrations, may differ from runtime URL


# --- Analytics (Phase 6) ------------------------------------------------------
# [BLOCKED] Founder decision pending. If used, MUST be privacy-respecting.
# Plausible and Fathom are acceptable; Google Analytics is not.
#
# CRITICAL RULE: the /antyeshti route is excluded from all analytics regardless
# of provider. This exclusion lives in the analytics initialization code,
# not in env vars — env-level toggling is too easy to flip by mistake.

NUXT_PUBLIC_ANALYTICS_PROVIDER=  # plausible | fathom | none
NUXT_PUBLIC_ANALYTICS_DOMAIN=    # e.g. sanatanasetu.com


# --- Feature flags (kill switches) --------------------------------------------
# These let the founder turn things off without redeploying.
# Use sparingly — every flag is technical debt.

# [OPTIONAL] If "true", the booking flow is disabled and the CTA on the home
# page redirects to a "we will notify you when bookings open" form instead.
NUXT_PUBLIC_BOOKING_ENABLED=true

# [OPTIONAL] If "true", the Antyeshti form is disabled. Use only if the team
# cannot meet the 4-hour callback SLA temporarily.
# WARNING: setting this to "false" hides the entire /antyeshti page.
NUXT_PUBLIC_ANTYESHTI_ENABLED=true

# [OPTIONAL] If "true", the calendar page renders. If "false", it 404s.
# Useful if panchangam data isn't reliable yet.
NUXT_PUBLIC_CALENDAR_ENABLED=true


# --- Development helpers ------------------------------------------------------

# [OPTIONAL] Set to "true" to expose /dev/components (the design system showcase
# route from Phase 1). MUST be "false" or unset in production.
NUXT_PUBLIC_DEV_ROUTES_ENABLED=false

# [OPTIONAL] If "true", form submissions log payloads to the server console
# instead of (or in addition to) actually sending notifications.
NUXT_DEV_LOG_FORM_SUBMISSIONS=true
